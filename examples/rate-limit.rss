use ngx;

let LIMIT = 5;
let WINDOW_SECONDS = 2;
let RETRY_AFTER = "2";

let key = ngx::var::get("rate_limit_key").unwrap_or("");
if key == "" {
    ngx::exit(ngx::http::status_service_unavailable());
}

let dict = ngx::shared::dict("ratelimit");
let added: SharedSafeStoreResult =
    ngx::shared::safe_add(dict, key, 1, WINDOW_SECONDS, ());
if added.ok {
    if 1 > LIMIT {
        ngx::header::set("Retry-After", RETRY_AFTER);
        ngx::exit(ngx::http::status_too_many_requests());
    }
} else {
    let added_error = match added.error {
        Option::Some(message) => message,
        Option::None => ""
    };
    if added_error != "exists" {
        ngx::exit(ngx::http::status_service_unavailable());
    }
    let counted: SharedIncrResult = ngx::shared::incr(dict, key, 1, (), ());
    let counted_error = match counted.error {
        Option::Some(message) => message,
        Option::None => ""
    };
    if counted_error != "" {
        ngx::exit(ngx::http::status_service_unavailable());
    }
    if counted.forcible {
        ngx::exit(ngx::http::status_service_unavailable());
    }
    if counted.value.unwrap_or(0.0) > LIMIT {
        ngx::header::set("Retry-After", RETRY_AFTER);
        ngx::exit(ngx::http::status_too_many_requests());
    }
}
