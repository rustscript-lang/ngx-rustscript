# WARNING: Copy-paste starting point only. Replace pepper and current digest
# placeholders before use. Never commit live API tokens, peppers, or HMAC
# digests.
#
# Root-readable secrets include contract:
# - mode 0600, owner = the NGINX master user (typically root)
# - not world-readable, outside the web root, not in the git tree
# - replace atomically: write a sibling file, fsync, rename onto this path,
#   then `nginx -s reload`. Do not edit the live include in place.
#
# HMAC-SHA1 is the only keyed digest host. This example verifies an opaque
# high-entropy token; it is not a message signature scheme.
#
# Trusted variables below must come from `set` in this include, never from
# $http_*, $arg_*, or $cookie_*. Previous digest defaults to empty, so only
# the current digest authorizes until rotation copies the old current value
# here. Leftover REPLACE_* pepper/digest placeholders cannot authorize a
# client token.

set $rss_api_key_pepper "REPLACE_WITH_HIGH_ENTROPY_PEPPER";
set $rss_api_key_digest "REPLACE_WITH_BASE64_NOPAD_HMAC_SHA1_DIGEST";
set $rss_api_key_digest_prev "";
