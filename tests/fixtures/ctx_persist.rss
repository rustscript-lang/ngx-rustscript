use ngx;
ngx::ctx::set("n", 1);
ngx::ctx::set("k", "v");
ngx::ctx::set("user", { id: 7, name: "ada" });
ngx::sleep_ms(10);
ngx::ctx::set("n", 2);
ngx::sleep_ms(10);
ngx::log(ngx::log_level::notice(), "CTX_PERSIST=" + ngx::encode_args({ n: ngx::ctx::get("n"), k: ngx::ctx::get("k") }));
ngx::log(ngx::log_level::notice(), "CTX_USER=" + ngx::encode_args(ngx::ctx::get("user")));
