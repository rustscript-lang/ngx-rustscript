use ngx;
ngx::ctx::set("n", "1");
ngx::ctx::set("k", "v");
ngx::ctx::set("user", "ada");
ngx::sleep_ms(10);
ngx::ctx::set("n", "2");
ngx::sleep_ms(10);
ngx::log(ngx::log_level::notice(), "CTX_PERSIST=" + ngx::encode_args({ n: ngx::ctx::get("n").unwrap_or(""), k: ngx::ctx::get("k").unwrap_or("") }));
ngx::log(ngx::log_level::notice(), "CTX_USER=" + ngx::ctx::get("user").unwrap_or(""));
