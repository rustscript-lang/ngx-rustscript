worker_processes 1;
error_log stderr emerg;
pid "@@PREFIX@@/logs/nginx.pid";
daemon off;
master_process off;

load_module @@MODULE@@;

events {
    worker_connections 32;
}

http {
    access_log off;
    server {
        listen 127.0.0.1:18080;
        server_name localhost;
        location / {
            return 200 "ok\n";
        }
    }
}
